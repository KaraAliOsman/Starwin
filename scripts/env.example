# Copiar a .env en la raíz del proyecto; nunca subir .env ni pegar claves en el chat.
# El visualizador permanece deshabilitado si falta cualquiera de estas variables.
# Confirmar que la clave fue emitida por Google Gemini antes de elegir este proveedor.
GEMINI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_ALLOW_PAID_GENERATION=false
VISUALIZER_BILLING_HOLD=false
VISUALIZER_SESSION_LIMIT=3
VISUALIZER_GLOBAL_DAILY_LIMIT=30
VISUALIZER_CONCURRENCY=2

# Envío real de contacto. Sin ambos valores se prepara un correo, no se envía.
RESEND_API_KEY=
CONTACT_FROM=

# Solo para el proceso local. No altera la publicación ni crea infraestructura.
PORT=3005
