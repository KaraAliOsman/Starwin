---
import Layout from '../layouts/Layout.astro';
import HomeShowroom from '../components/HomeShowroom.astro';
import '../styles/home.css';
import '../styles/scroll-stories.css';
import {site,serviceAreaSchema} from '../config/site';
import {businessId,canonicalUrl} from '../lib/seo';
import {products} from '../data/products';
const schema=[{
 '@context':'https://schema.org','@type':'Service',
 '@id':`${canonicalUrl('/')}#servicio`,
 name:'Fabricación e instalación de ventanas de PVC en Concepción y Biobío',
 serviceType:'Ventanas de PVC a medida y termopanel',
 provider:{'@id':businessId},
 areaServed:serviceAreaSchema(),
 hasOfferCatalog:{'@type':'OfferCatalog',name:'Ventanas de PVC Starwin',itemListElement:products.map(product=>({'@type':'OfferCatalog',name:product.name,url:canonicalUrl(`/ventanas/${product.slug}/`)}))}
}];
---
<Layout title="Ventanas de PVC en Biobío y Concepción | Starwin" description="Fabricamos e instalamos ventanas de PVC y termopanel en toda la Región del Biobío. Desde Concepción a Los Ángeles y Arauco. Consulta tu proyecto o estima online." schema={schema}><HomeShowroom/></Layout>
<script>import '../scripts/home-motion';</script>
