---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picture from '../../components/Picture.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import PriceExamples from '../../components/PriceExamples.astro';
import {articles} from '../../data/articles';
import {articlePhotos} from '../../data/article-photos';
import {absolute} from '../../config/site';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article:a}=Astro.props;
const photo=articlePhotos[a.image];
const relatedTool=({'como-medir-ventanas':{href:'/medir-ventanas/',name:'Calcula m² y prepara tu ficha PDF'},'condensacion-en-ventanas':{href:'/calculadora-condensacion/',name:'Calcula el punto de rocío'},'elegir-apertura-ventana':{href:'/elegir-ventana/',name:'Encuentra tu apertura'},'pvc-y-termopanel':{href:'/comparar-ventanas/',name:'Compara dos aperturas'}} as Record<string,{href:string;name:string}>)[a.slug];
const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:a.title,description:a.description,image:absolute(`/images/${photo.name}-1600.webp`),datePublished:'2026-10-19',dateModified:'2026-10-19',inLanguage:'es-CL',author:{'@type':'Organization',name:'Starwin PVC Chile',url:absolute('/nosotros/')},publisher:{'@id':absolute('/#empresa')},mainEntityOfPage:absolute(`/blog/${a.slug}/`)};
---
<Layout title={`${a.title} | Guías Starwin`} description={a.description} schema={schema}>
 <Breadcrumb items={[{name:'Guías',href:'/blog/'},{name:a.category,href:`/blog/${a.slug}/`}]}/><article><header class="article-header wrap"><span class="eyebrow">{a.category} · {a.minutes} min de lectura</span><h1>{a.title}</h1><p class="lede">{a.intro}</p><div class="article-byline"><span>Por el equipo de Starwin</span><span>19 de octubre de 2026</span></div></header><div class="article-cover wrap"><Picture name={photo.name} alt={photo.alt} sourceMaxWidth={photo.maxWidth} width={1400} height={650} eager sizes="(max-width: 700px) 100vw, 90vw"/></div><div class="article-layout wrap"><aside><nav aria-label="En esta guía"><span class="eyebrow">En esta guía</span>{a.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav>{relatedTool && <a class="article-tool-link" href={relatedTool.href}>{relatedTool.name}<Icon name="arrow" size={18}/></a>}<div class="article-aside-cta"><Icon name="chat" size={26}/><p>Una orientación<br/>para tu proyecto.</p><a class="text-link" href="/contacto/">Hablemos de tus ventanas <Icon name="diagonal" size={15}/></a></div></aside><div class="article-body rich"><div class="article-takeaway"><span class="eyebrow">Lo esencial</span><p>{a.takeaway}</p></div>{a.sections.map(s=><section id={s.id}><h2>{s.title}</h2><Fragment set:html={s.html}/>{a.slug==='precio-ventanas-pvc-concepcion'&&s.id==='cotizar'&&<PriceExamples/>}</section>)}<div class="article-context"><p>Esta guía es orientativa. Las prestaciones, dimensiones, plazos y condiciones deben confirmarse para el sistema y el proyecto específico.</p><a href="/contacto/">Consultar mi proyecto con Starwin</a></div><div class="share-line"><a href={`https://wa.me/?text=${encodeURIComponent(a.title+' '+absolute(`/blog/${a.slug}/`))}`} target="_blank" rel="noopener noreferrer">Compartir esta guía por WhatsApp <Icon name="diagonal" size={15}/></a><a href="/blog/">Volver a las guías</a></div></div></div></article>
 <section class="section section-white"><div class="wrap"><div class="section-heading"><h2>Para seguir eligiendo bien.</h2></div><div class="cards-grid">{articles.filter(other=>other.slug!==a.slug).slice(0,3).map(article=><ArticleCard article={article}/>)}</div></div></section><CTA/>
</Layout>
<style>.article-header{padding-top:45px;padding-bottom:38px;max-width:1070px}.article-header h1{font-size:clamp(39px,4.6vw,64px);line-height:1.09;max-width:1000px}.article-header .lede{max-width:850px;font-size:20px}.article-byline{display:flex;gap:25px;align-items:center;font-size:11px;color:var(--muted);margin-top:25px}.article-cover{height:440px;position:relative}.article-cover>img{width:100%;height:100%}.article-layout{display:grid;grid-template-columns:230px minmax(0,750px);justify-content:center;gap:80px;padding:65px 0 85px}.article-layout aside{align-self:start;position:sticky;top:125px}.article-layout aside nav>a{display:block;font-size:12px;line-height:1.6;padding:10px 0;border-bottom:1px solid var(--line);min-height:44px}.article-layout aside .eyebrow{font-size:10px;margin-bottom:14px}.article-aside-cta{margin-top:30px;padding:25px 20px;background:#edf6fa}.article-aside-cta>svg{color:var(--blue)}.article-aside-cta p{font-size:22px;letter-spacing:-.02em;line-height:1.25;margin:20px 0 8px}.article-aside-cta .text-link{font-size:11px;gap:8px}.article-takeaway{border-left:3px solid var(--blue);background:#edf6fa;padding:27px 30px;margin-bottom:32px}.article-takeaway .eyebrow{font-size:10px;margin-bottom:12px}.article-takeaway p{font-size:19px;line-height:1.6;margin:0}.article-body section{scroll-margin-top:120px}.article-context{border-top:1px solid var(--line);padding-top:25px;margin-top:50px;font-size:12px;color:var(--muted)}.article-context a{font-size:13px}.share-line{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid var(--line);margin-top:35px;padding-top:20px;font-size:11px}.share-line a{min-height:44px;display:flex;align-items:center;gap:8px}@media(max-width:1000px){.article-layout{gap:40px;grid-template-columns:200px minmax(0,1fr)}.article-cover{height:380px}}@media(max-width:700px){.article-header{padding-top:30px;padding-bottom:28px}.article-header h1{font-size:38px;letter-spacing:-.045em}.article-header .lede{font-size:17px}.article-byline{font-size:10px;gap:16px;margin-top:22px}.article-cover{height:250px}.article-layout{display:flex;flex-direction:column;gap:30px;padding:32px 0 50px}.article-layout aside{position:static;width:100%}.article-layout aside nav{background:#f0f7fa;padding:20px}.article-layout aside nav>a{font-size:12px;padding:8px 0;min-height:39px}.article-aside-cta{display:none}.article-takeaway{padding:22px;margin-bottom:26px}.article-takeaway p{font-size:17px}.share-line{align-items:start;flex-direction:column;gap:3px;font-size:11px}}</style>

<style>.article-tool-link{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px;background:#dceef4;font-size:15px;line-height:1.4;margin-top:20px;min-height:60px}.article-tool-link svg{flex-shrink:0;color:#006d94}</style>
