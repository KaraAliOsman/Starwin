---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import {tools} from '../features/tools/model';
import {absolute} from '../config/site';
import '../styles/interior-2026.css';
const entries=[{slug:'visualizador',name:'Visualizador fotográfico'},{slug:'cotizador',name:'Estimador con PDF y 3D'},...tools];
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Herramientas para ventanas Starwin',itemListElement:entries.map((tool,index)=>({'@type':'ListItem',position:index+1,name:tool.name,url:absolute(`/${tool.slug}/`)}))};
---
<Layout title="Herramientas para ventanas: comparar, medir, visualizar y estimar | Starwin" description="Encuentra tu apertura, compara ventanas de PVC, calcula m², descarga una ficha de medidas y revisa la condensación. Explora también el visualizador y el estimador con PDF y 3D." schema={schema}>
 <div class="interior-page tools-page">
  <Breadcrumb items={[{name:'Herramientas',href:'/herramientas/'}]}/>
  <header class="interior-intro wrap"><h1>De la idea a tu ventana.</h1><p>Prueba, compara y prepara tu proyecto. A tu ritmo.</p></header>
  <section class="tools-visual wrap" aria-labelledby="visual-tool-title"><a class="tools-visual-photo" href="/visualizador/"><img src="/images/scene-comedor-960.webp" srcset="/images/scene-comedor-480.webp 480w, /images/scene-comedor-960.webp 960w" sizes="(max-width:700px) 100vw, 58vw" width="1200" height="900" alt="Comedor con un ventanal hacia una terraza y jardín" fetchpriority="high" decoding="async"/></a><div><h2 id="visual-tool-title">Empieza con tu casa.</h2><p>Explora una propuesta de ventanas a partir de una foto de tu espacio.</p><a class="interior-primary" href="/visualizador/">Ver visualizador <Icon name="arrow" size={20}/></a><p class="interior-note">La generación de imágenes depende de la disponibilidad del servicio.</p></div></section>
  <section class="tools-directory wrap" aria-labelledby="choose-tool-title"><div class="tools-directory-heading"><h2 id="choose-tool-title">Resuelve tu siguiente duda.</h2><p>Sin crear una cuenta.</p></div>{tools.map(tool=><a class="tools-directory-row" href={`/${tool.slug}/`}><figure><Picture name={tool.image} alt="" width={1000} height={800} sourceMaxWidth={1000} sizes="(max-width:700px) 28vw, 18vw"/></figure><div><h3>{tool.name}</h3><p>{tool.description}</p></div><span class="tools-directory-action">{tool.action} <Icon name="arrow" size={22}/></span></a>)}</section>
  <section class="tools-estimator wrap" aria-labelledby="estimator-title"><figure><Picture name="sliding" alt="Ventana corredera blanca con una hoja desplazada" width={1000} height={800} sizes="(max-width:700px) 100vw, 50vw" sourceMaxWidth={1000}/></figure><div class="tools-estimator-copy"><h2 id="estimator-title">Ponle números.</h2><p>Medidas, apertura, vidrio y acabado. Varias ventanas, un presupuesto PDF y una vista 3D.</p><a class="interior-button" href="/cotizador/">Abrir estimador <Icon name="arrow" size={20}/></a><p class="interior-price-note">Referencia sujeta a revisión de medidas, configuración y factibilidad.</p><a class="interior-link" href="/cotizador/?view=3d">Explorar en 3D <Icon name="cube" size={18}/></a></div></section>
  <section class="interior-help wrap"><div><h2>Cuéntanos tu idea.</h2><p>Una foto, tus medidas o una primera pregunta.</p></div><a class="interior-primary" href="/contacto/">Hablar de mi proyecto <Icon name="arrow" size={19}/></a><a class="interior-link" href="/preparar-proyecto/">Preparar mi consulta <Icon name="arrow" size={18}/></a></section>
 </div>
</Layout>
<style>
 .tools-visual{display:grid;grid-template-columns:1.2fr 1fr;background:#e9f2f5}.tools-visual-photo{display:block;min-width:0}.tools-visual-photo img{width:100%;height:390px;object-fit:cover}.tools-visual>div{align-self:center;padding:35px 42px}.tools-visual h2{font-size:40px}.tools-visual p{font-size:17px;margin:18px 0 25px;max-width:31ch}.tools-visual p.interior-note{font-size:12px;margin:18px 0 0}.tools-directory{padding-block:60px}.tools-directory-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:25px}.tools-directory-heading>p{font-size:15px;color:#53636b}.tools-directory-row{display:grid;grid-template-columns:190px 1fr auto;align-items:center;gap:32px;padding-block:18px}.tools-directory-row:nth-of-type(even){background:#f3f6f7}.tools-directory-row figure{height:140px;min-width:0}.tools-directory-row img{width:100%;height:100%;object-fit:contain}.tools-directory-row h3{font-size:27px}.tools-directory-row p{font-size:16px;color:#53636b;margin-top:12px;max-width:40ch}.tools-directory-action{display:flex;align-items:center;gap:22px;font-size:15px;padding-right:22px;min-height:48px}.tools-directory-row:focus-visible{outline-offset:4px}.tools-page .tools-estimator{margin-bottom:50px}
 @media(hover:hover) and (pointer:fine){.tools-directory-row:hover{background:#e5eff3}.tools-directory-row:hover .tools-directory-action{color:#006d94}}
 @media(max-width:900px){.tools-directory-row{grid-template-columns:150px 1fr;gap:15px 28px}.tools-directory-action{grid-column:2;padding:0}.tools-directory-row figure{grid-row:1/3;height:155px}.tools-visual>div{padding:25px}.tools-visual h2{font-size:32px}}
 @media(max-width:700px){.tools-visual{grid-template-columns:1fr}.tools-visual-photo img{height:240px}.tools-visual>div{padding:26px 22px 28px}.tools-visual h2{font-size:30px}.tools-visual p{font-size:16px;max-width:none}.tools-visual .interior-primary{width:100%}.tools-directory{padding-block:40px}.tools-directory-heading{display:block;margin-bottom:15px}.tools-directory-heading h2{font-size:27px;max-width:17ch}.tools-directory-heading>p{margin-top:12px;font-size:14px}.tools-directory-row{grid-template-columns:minmax(80px,28%) 1fr;gap:10px 17px;padding:20px 12px}.tools-directory-row figure{height:125px}.tools-directory-row h3{font-size:22px;line-height:1.15}.tools-directory-row p{font-size:14px;margin-top:10px}.tools-directory-action{font-size:14px;justify-content:space-between;gap:8px}.tools-directory-action svg{width:18px}.tools-page .tools-estimator{margin-bottom:35px}}
</style>

