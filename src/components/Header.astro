---
import Icon from './Icon.astro';
import QuoteEntry from './QuoteEntry.astro';
const path=Astro.url.pathname;
const links=[['Ventanas','/ventanas/'],['Acabados','/colores/'],['Trabajos','/trabajos-realizados/'],['Herramientas','/herramientas/'],['Empresas','/empresas/']];
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
 <div class="wrap header-inner">
  <a href="/" class="brand" aria-label="Starwin, inicio"><img src="/starwin-logo-small.webp" alt="Starwin" width="178" height="30"/></a>
  <nav class="main-nav" id="navegacion" aria-label="Principal">
   {links.map(([label,href])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}
   <a href="/nosotros/" class="nav-mobile-extra">Starwin</a>
   <a href="/blog/" class="nav-mobile-extra">Guías</a>
  </nav>
  <div class="header-actions">
   <a href="/cotizar/" class="btn btn-small quote-launch" data-quote-open aria-current={path==='/cotizar/'?'page':undefined}><span>Cotizar</span><Icon name="diagonal" size={18}/></a>
   <button class="menu-button" type="button" aria-label="Abrir menú" aria-controls="navegacion" aria-expanded="false"><span class="menu-word menu-word--closed" aria-hidden="true">Menú</span><span class="menu-word menu-word--open" aria-hidden="true">Cerrar</span><svg class="menu-lines" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="menu-line-top" d="M2 8h20"/><path class="menu-line-bottom" d="M2 16h20"/></svg></button>
  </div>
 </div>
</header>
<QuoteEntry/>
