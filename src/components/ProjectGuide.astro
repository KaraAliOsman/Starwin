---
import { articles } from '../data/articles';
import { site, wa } from '../config/site';

const topics = [
  {
    label: 'Frío',
    heading: 'Frío y corrientes de aire',
    first: 'El vidrio, el cierre y el encuentro con el muro influyen en el aislamiento de una ventana.',
    second: 'Cuéntanos dónde sientes el frío y si entra aire con la ventana cerrada para orientar la revisión.',
    slug: 'pvc-y-termopanel',
    guideLabel: 'Entender PVC y termopanel',
    message: 'Hola Starwin, quiero revisar mis ventanas porque siento frío o corrientes de aire. ¿Qué información les puedo enviar?',
  },
  {
    label: 'Ruido',
    heading: 'Ruido del exterior',
    first: 'La composición del vidrio, las juntas y la instalación deben revisarse junto con otras entradas de sonido del recinto.',
    second: 'Dinos qué ruido te molesta y en qué momento se escucha; un termopanel por sí solo no define el resultado acústico.',
    slug: 'ventanas-y-ruido',
    guideLabel: 'Qué revisar frente al ruido',
    message: 'Hola Starwin, quiero mejorar el aislamiento frente al ruido exterior. Me gustaría contarles cómo es mi caso.',
  },
  {
    label: 'Humedad',
    heading: 'Humedad en la ventana',
    first: 'Agua en la cara interior, humedad entre vidrios y filtración durante la lluvia requieren revisiones diferentes.',
    second: 'Identifica dónde y cuándo aparece: cambiar la ventana no elimina por sí solo el exceso de humedad de una habitación.',
    slug: 'condensacion-en-ventanas',
    guideLabel: 'Identificar la condensación',
    message: 'Hola Starwin, veo humedad en mi ventana y quiero orientar una revisión. Puedo contarles dónde y cuándo aparece.',
  },
  {
    label: 'Renovar',
    heading: 'Cambiar ventanas existentes',
    first: 'Además de la apertura y el acabado, conviene revisar el marco actual, el estado del vano y las terminaciones.',
    second: 'Puedes empezar con una foto y la cantidad de ventanas; no necesitas tener todas las medidas para consultarnos.',
    slug: 'instalacion-ventanas-concepcion',
    guideLabel: 'Preparar el cambio de ventanas',
    message: 'Hola Starwin, quiero cambiar ventanas existentes. ¿Podemos revisar las opciones y el alcance del proyecto?',
  },
  {
    label: 'Obra nueva',
    heading: 'Ventanas para una obra nueva',
    first: 'La apertura debe coordinarse con la ventilación, los muebles, el acceso para limpiar y las condiciones de cada recinto.',
    second: 'Si tienes planos o un cuadro de ventanas, puedes compartirlos al contactarnos; también podemos partir por una descripción del proyecto.',
    slug: 'elegir-apertura-ventana',
    guideLabel: 'Comparar tipos de apertura',
    message: 'Hola Starwin, estoy preparando una obra nueva y quiero revisar aperturas y ventanas para el proyecto.',
  },
].map((topic) => {
  const article = articles.find((article) => article.slug === topic.slug);
  if (!article) throw new Error(`Falta la guía de ventanas: ${topic.slug}`);
  return {
    ...topic,
    guideHref: `/blog/${article.slug}/`,
    whatsappHref: wa(topic.message),
    emailHref: `mailto:${site.email}?subject=${encodeURIComponent(`Consulta Starwin · ${topic.heading}`)}&body=${encodeURIComponent(topic.message)}`,
  };
});
const initial = topics[0];
---

<section class="project-guide" data-project-guide aria-label="Orientación para tu proyecto">
  <div class="project-guide-inner">
    <div class="project-guide-heading">
      
      <h2>¿Qué quieres mejorar?</h2>
      <p>Podemos empezar por lo que necesitas resolver.</p>
    </div>

    <div class="project-guide-content">
      <div class="project-guide-options" data-guide-options role="group" aria-label="Elige una necesidad" hidden>
        {topics.map((topic, index) => (
          <button
            type="button"
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-guide-choice
            data-heading={topic.heading}
            data-first={topic.first}
            data-second={topic.second}
            data-guide-href={topic.guideHref}
            data-guide-label={topic.guideLabel}
            data-whatsapp-href={topic.whatsappHref}
            data-email-href={topic.emailHref}
          >{topic.label}</button>
        ))}
      </div>

      <div class="project-guide-result" aria-live="polite" aria-atomic="true">
        <h3 data-guide-heading>{initial.heading}</h3>
        <p data-guide-first>{initial.first}</p>
        <p data-guide-second>{initial.second}</p>
        <div class="project-guide-links">
          <a class="project-guide-contact" data-guide-whatsapp href={initial.whatsappHref} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="project-guide-read" data-guide-link href={initial.guideHref}>{initial.guideLabel} <span aria-hidden="true">→</span></a>
          <a class="project-guide-read" data-guide-email href={initial.emailHref}>Prefiero correo <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <noscript>
        <div class="project-guide-without-js">
          <p>También puedes empezar por estas guías:</p>
          <ul>{topics.slice(1).map((topic) => <li><a href={topic.guideHref}>{topic.guideLabel}</a></li>)}</ul>
        </div>
      </noscript>
    </div>
  </div>
</section>

<style>
  .project-guide{--guide-ink:var(--ink,#1d2528);--guide-muted:var(--muted,#62696b);--guide-line:var(--line,#d7dada);color:var(--guide-ink);border-top:1px solid var(--guide-line);border-bottom:1px solid var(--guide-line);background:#fff;padding:64px 0}
  .project-guide-inner{width:min(1380px,calc(100% - 112px));margin-inline:auto;display:grid;grid-template-columns:1fr 1.15fr;gap:76px}
  .project-guide-kicker{display:block;font-size:11px;line-height:1.5;letter-spacing:.12em;text-transform:uppercase;color:var(--guide-muted);margin-bottom:20px}
  .project-guide h2{font-size:clamp(34px,3.5vw,50px);font-weight:400;letter-spacing:-.045em;line-height:1.08;margin:0 0 20px;text-wrap:balance}
  .project-guide-heading>p{font-size:15px;line-height:1.65;color:var(--guide-muted);margin:0;max-width:330px}
  .project-guide-content{min-width:0}
  .project-guide-options{display:flex;flex-wrap:wrap;gap:0 20px;border-bottom:1px solid var(--guide-line);padding-bottom:15px;margin-bottom:28px}
  .project-guide-options[hidden]{display:none!important}
  .project-guide-options button{appearance:none;position:relative;min-height:48px;min-width:44px;padding:10px 2px;border:0;border-radius:0;background:transparent;color:var(--guide-muted);font:inherit;font-size:14px;line-height:1.3;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
  .project-guide-options button::after{content:'';position:absolute;bottom:2px;left:2px;right:2px;height:2px;background:currentColor;transform:scaleX(0);transform-origin:left}
  .project-guide-options button[aria-pressed=true]{color:var(--guide-ink);font-weight:600}
  .project-guide-options button[aria-pressed=true]::after{transform:scaleX(1)}
  .project-guide-result h3{font-size:23px;font-weight:400;letter-spacing:-.02em;line-height:1.25;margin:0 0 15px}
  .project-guide-result p{font-size:15px;line-height:1.65;color:var(--guide-muted);margin:0 0 12px;max-width:620px}
  .project-guide-links{display:flex;flex-wrap:wrap;align-items:center;gap:10px 26px;margin-top:23px}
  .project-guide-links a{display:inline-flex;align-items:center;justify-content:space-between;gap:18px;min-height:48px;text-decoration:none;font-size:13px;line-height:1.4}
  .project-guide-contact{padding:12px 18px;background:var(--guide-ink);color:#fff}
  .project-guide-read{padding:10px 0;color:var(--guide-ink);text-decoration:underline!important;text-underline-offset:5px;text-decoration-thickness:1px}
  .project-guide a:focus-visible,.project-guide button:focus-visible{outline:3px solid #15586b;outline-offset:5px}
  .project-guide-without-js{margin-top:26px;padding-top:20px;border-top:1px solid var(--guide-line);font-size:14px;line-height:1.6}
  .project-guide-without-js p{margin:0 0 8px;color:var(--guide-muted)}
  .project-guide-without-js ul{list-style:none;margin:0;padding:0}
  .project-guide-without-js a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:4px}
  @media(hover:hover) and (pointer:fine){.project-guide-options button:hover{color:var(--guide-ink)}.project-guide-contact:hover{background:#35434a}.project-guide-read:hover{color:#15586b}}
  @media(max-width:1100px){.project-guide-inner{width:calc(100% - 64px);gap:42px}}
  @media(max-width:700px){.project-guide{padding:44px 0}.project-guide-inner{width:calc(100% - 40px);grid-template-columns:1fr;gap:25px}.project-guide-kicker{font-size:10px;margin-bottom:16px}.project-guide h2{font-size:35px;margin-bottom:15px}.project-guide-heading>p{max-width:none;font-size:14px}.project-guide-options{gap:0 18px;padding-bottom:12px;margin-bottom:23px}.project-guide-options button{font-size:14px}.project-guide-result h3{font-size:22px}.project-guide-result p{font-size:14px}.project-guide-links{gap:10px 22px;margin-top:20px}.project-guide-links a{font-size:13px}.project-guide-contact{padding-inline:16px}}
  @media(max-width:359px){.project-guide-inner{width:calc(100% - 32px)}.project-guide h2{font-size:32px}.project-guide-options{gap:0 16px}}
  @media print{.project-guide{padding:24px 0;background:#fff}.project-guide-inner{width:100%;gap:24px}.project-guide-options{display:none!important}.project-guide-links a{color:#000;background:transparent;padding:0}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-guide]').forEach((guide) => {
    const options = guide.querySelector<HTMLElement>('[data-guide-options]');
    const choices = guide.querySelectorAll<HTMLButtonElement>('[data-guide-choice]');
    const heading = guide.querySelector<HTMLElement>('[data-guide-heading]');
    const first = guide.querySelector<HTMLElement>('[data-guide-first]');
    const second = guide.querySelector<HTMLElement>('[data-guide-second]');
    const article = guide.querySelector<HTMLAnchorElement>('[data-guide-link]');
    const whatsapp = guide.querySelector<HTMLAnchorElement>('[data-guide-whatsapp]');
    const email = guide.querySelector<HTMLAnchorElement>('[data-guide-email]');
    if (!options || !heading || !first || !second || !article || !whatsapp || !email) return;

    choices.forEach((choice) => {
      choice.addEventListener('click', () => {
        if (choice.getAttribute('aria-pressed') === 'true') return;
        choices.forEach((button) => button.setAttribute('aria-pressed', String(button === choice)));
        heading.textContent = choice.dataset.heading || '';
        first.textContent = choice.dataset.first || '';
        second.textContent = choice.dataset.second || '';
        article.href = choice.dataset.guideHref || article.href;
        article.replaceChildren(document.createTextNode(`${choice.dataset.guideLabel || 'Leer la guía'} `));
        const arrow = document.createElement('span');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        article.append(arrow);
        whatsapp.href = choice.dataset.whatsappHref || whatsapp.href;
        email.href = choice.dataset.emailHref || email.href;
      });
    });
    options.hidden = false;
  });
</script>

