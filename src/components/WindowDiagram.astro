 <rect x="26" y="24" width="228" height="172" fill={color} stroke="#899495" stroke-width="1.2"/>
 <rect x="34" y="32" width="212" height="156" fill="#e6ecea" stroke="#b3bcb9"/>
 <path d="M35 160 110 92l37 38 45-53 53 54v56H35Z" fill="#dae4df" opacity=".8"/>
