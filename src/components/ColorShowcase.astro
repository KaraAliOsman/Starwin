---
import Icon from './Icon.astro';
import {wa} from '../config/site';
const finishes=[{id:'white',name:'Blanco',hex:'#ececec'},{id:'anthracite',name:'Antracita',hex:'#41484c'},{id:'oak',name:'Roble dorado',hex:'#aa7b42'}];
---
<div class="finish-showcase material-studio" data-material-studio><div class="material-stage"><img data-material-image src="/images/studio-white-900.webp" width="900" height="1125" alt="Ventana de PVC en acabado blanco" loading="lazy" decoding="async"/></div><div class="material-copy"><h2>Blanco, antracita<br/>o madera.</h2><p class="lede">Mira cómo cambia la misma ventana.</p><div class="material-options" role="group" aria-label="Comparar acabados">{finishes.map((f,i)=><button type="button" data-material-finish={f.id} data-material-name={f.name} style={`--finish:${f.hex}`} aria-pressed={i===0?'true':'false'}><span></span>{f.name}</button>)}</div><p class="material-selection" aria-live="polite" data-material-label>Blanco</p><a class="text-link" data-material-contact href={wa('Hola Starwin, me interesa el acabado Blanco. Quiero consultar muestras y disponibilidad.')} target="_blank" rel="noopener noreferrer">Consultar este acabado <Icon name="diagonal" size={18}/></a><p class="small">Confirma el acabado con una muestra.</p></div></div>
<style>
 .material-studio{display:grid;grid-template-columns:1.15fr 1fr;gap:70px;align-items:center}.material-stage{height:560px;position:relative;isolation:isolate;background:#edf5f8;overflow:hidden}.material-stage>span{position:absolute;inset:45% 0 auto;font:450 110px/1 Manrope,Arial,sans-serif;letter-spacing:-.06em;color:#1595c3;text-align:center;z-index:-1}.material-stage img{height:100%;width:100%;object-fit:contain;transform:none}.material-copy h2{font-size:42px}.material-copy .lede{font-size:16px;margin-top:21px}.material-options{display:flex;gap:18px;margin:25px 0 15px}.material-options button{padding:0;display:flex;align-items:center;flex-direction:column;gap:13px;min-height:80px;font-size:11px}.material-options button>span{width:34px;height:34px;border-radius:50%;background:var(--finish);border:1px solid #0002;outline:1px solid transparent;outline-offset:5px}.material-options button[aria-pressed=true]>span{outline-color:var(--blue)}.material-selection{font-size:14px;font-weight:600;margin:0 0 12px}.material-copy .text-link{font-size:12px}.material-copy .small{font-size:11px;line-height:1.6;max-width:330px;margin-top:25px}@media(max-width:900px){.material-studio{gap:35px}.material-stage{height:460px}.material-stage>span{font-size:80px}.material-copy h2{font-size:33px}}@media(max-width:700px){.material-studio{grid-template-columns:1fr;gap:28px}.material-stage{height:350px}.material-stage>span{font-size:87px}.material-copy h2{font-size:32px}.material-copy .lede{font-size:15px}.material-options{gap:23px;margin-top:24px}.material-copy .small{margin-top:20px}}
</style>
<script>
 document.querySelectorAll<HTMLElement>('[data-material-studio]').forEach(studio=>{const image=studio.querySelector<HTMLImageElement>('[data-material-image]'),label=studio.querySelector<HTMLElement>('[data-material-label]'),contact=studio.querySelector<HTMLAnchorElement>('[data-material-contact]');const buttons=studio.querySelectorAll<HTMLButtonElement>('[data-material-finish]');let revision=0;buttons.forEach(button=>button.addEventListener('click',async()=>{if(!image||!label||!contact)return;const current=++revision;const next=new Image();const name=button.dataset.materialName||'';next.src=`/images/studio-${button.dataset.materialFinish}-900.webp`;try{await next.decode();if(current!==revision)return;image.src=next.src;image.alt=`Ventana de PVC en acabado ${name.toLowerCase()}`;label.textContent=name;const url=new URL(contact.href);url.searchParams.set('text',`Hola Starwin, me interesa el acabado ${name}. Quiero consultar muestras y disponibilidad.`);contact.href=url.toString();buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}catch{label.textContent='No se pudo cargar este acabado. Vuelve a intentarlo.';}}));});
</script>
