---
import Icon from './Icon.astro';
const {business=false,id='contact'}=Astro.props;
---
<form class="contact-form" id={id} data-contact-form method="post" action="/api/contact" novalidate>
 <div class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></div>
 <div class="form-grid">
  <div class="field"><label for={`${id}-name`}>Tu nombre <span>*</span></label><input id={`${id}-name`} name="name" autocomplete="name" required maxlength="90" placeholder="Nombre y apellido" aria-describedby={`${id}-name-error`}/><span class="field-error" id={`${id}-name-error`} data-error="name"></span></div>
  <div class="field"><label for={`${id}-email`}>Correo electrónico <span>*</span></label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="160" placeholder="tu@correo.cl" aria-describedby={`${id}-email-error`}/><span class="field-error" id={`${id}-email-error`} data-error="email"></span></div>
  {business&&<div class="field full"><label for={`${id}-company`}>Empresa o estudio <span class="optional">Opcional</span></label><input id={`${id}-company`} name="company" autocomplete="organization" maxlength="160" aria-describedby={`${id}-company-error`}/><span class="field-error" id={`${id}-company-error`} data-error="company"></span></div>}
  <input type="hidden" name="kind" value={business?'Empresa / arquitectura':'Hogar'}/>
  <div class="field full"><label for={`${id}-message`}>Cuéntanos tu proyecto <span>*</span></label><textarea id={`${id}-message`} name="message" rows="4" minlength="15" maxlength="4000" required aria-describedby={`${id}-message-help ${id}-message-error`} placeholder={business?'Ubicación, etapa de obra y lo que necesitas resolver.':'Qué quieres mejorar y en qué comuna está tu proyecto.'}></textarea><small id={`${id}-message-help`}>Puedes añadir fotos o planos al correo que prepares.</small><span class="field-error" id={`${id}-message-error`} data-error="message"></span></div>
 </div>
 <details class="contact-details"><summary>Agregar teléfono o comuna <span>Opcional</span></summary><div class="form-grid"><div class="field"><label for={`${id}-phone`}>Teléfono</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="+56 9…" aria-describedby={`${id}-phone-error`}/><span class="field-error" id={`${id}-phone-error`} data-error="phone"></span></div><div class="field"><label for={`${id}-city`}>Comuna</label><input id={`${id}-city`} name="city" autocomplete="address-level2" maxlength="100" placeholder="Ej. Concepción" aria-describedby={`${id}-city-error`}/><span class="field-error" id={`${id}-city-error`} data-error="city"></span></div></div></details>
 <div class="form-honey" aria-hidden="true"><label for={`${id}-website`}>Sitio web<input id={`${id}-website`} name="website" tabindex="-1" autocomplete="off"/></label></div>
 <label class="consent" for={`${id}-consent`}><input id={`${id}-consent`} type="checkbox" name="consent" required aria-describedby={`${id}-consent-error`}/><span>Autorizo a Starwin a usar estos datos para responder mi consulta. <a href="/privacidad/">Ver privacidad</a>.</span></label><span class="field-error" id={`${id}-consent-error`} data-error="consent"></span>
 <div class="form-bottom"><button class="btn" type="submit" data-submit disabled><span data-submit-label>Preparar consulta</span><Icon name="diagonal"/></button><span class="small">* Campos necesarios</span></div>
 <p class="form-delivery-note small">La consulta se prepara para enviarla con tu aplicación de correo.</p>
 <div class="mail-draft" hidden><h3>Tu consulta está preparada.</h3><p>Abre tu correo, revisa el mensaje y envíalo a Starwin. También puedes copiar el texto y enviarlo desde el correo que prefieras.</p><div class="button-row"><a class="btn" data-open-mail href="#">Abrir correo <Icon name="diagonal"/></a><button class="text-link" type="button" data-copy-mail>Copiar consulta</button></div><p class="small" data-copy-status role="status"></p><details><summary>Ver el mensaje preparado</summary><pre data-mail-preview></pre></details></div>
 <noscript><p class="notice">Para preparar la consulta, activa JavaScript o escribe directamente a <a href="mailto:starwinchile@gmail.com">starwinchile@gmail.com</a>.</p></noscript>
</form>
<style>
 .contact-form{position:relative}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:21px}.field{display:flex;flex-direction:column;gap:8px;min-width:0}.field.full{grid-column:1/-1}.field label{font-size:15px;font-weight:500}.field label>span{color:var(--blue);margin-left:3px}.field label .optional{font-weight:400;color:var(--muted);font-size:11px}.field input,.field select,.field textarea{min-width:0;width:100%;border:1px solid #b7c6cd;border-radius:3px;padding:13px 14px;background:#fff;font-size:16px;min-height:49px}.field textarea{resize:vertical;line-height:1.6}.field input[aria-invalid=true],.field textarea[aria-invalid=true]{border-color:#a54130}.field input::placeholder,.field textarea::placeholder{color:#7d8c8e}.field small{font-size:13px;color:var(--muted);line-height:1.5}.field-error{display:block;color:#9e3426;font-size:12px;line-height:1.5}.field-error:empty{display:none}.consent{display:flex;align-items:flex-start;gap:11px;font-size:12px;line-height:1.65;margin-top:23px;min-height:44px}.consent input{width:19px;height:19px;accent-color:var(--blue);flex-shrink:0;margin:2px 0 0}.consent a{text-decoration:underline;text-underline-offset:3px}.form-bottom{display:flex;align-items:center;gap:20px;margin-top:22px}.form-delivery-note{margin-top:14px;font-size:13px;max-width:450px}.form-status:not([hidden]){padding:17px 20px;background:#f4e7dc;color:#6b392a;font-size:14px;margin-bottom:25px;border-left:2px solid #a35f39}.form-status[data-sent=true]{background:#e4eee1;color:#2e502f}.form-honey{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}.mail-draft{margin-top:30px;padding:26px;background:#edf6fa;border:1px solid #c4dfe9}.mail-draft h3{font-size:24px}.mail-draft p{font-size:14px;margin-top:16px;color:var(--muted)}.mail-draft pre{font-family:inherit;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere;background:#fff;padding:15px;line-height:1.6}.mail-draft summary{font-size:13px;min-height:44px;cursor:pointer;padding-top:12px}.mail-draft details{margin-top:10px}
 @media(max-width:500px){.form-grid{grid-template-columns:1fr;gap:19px}.form-bottom{justify-content:space-between;gap:12px}.form-bottom .small{font-size:10px}.mail-draft{padding:20px}}
</style>
<script>
 const forms=document.querySelectorAll<HTMLFormElement>('[data-contact-form]');
 for(const form of forms){
  const submit=form.querySelector<HTMLButtonElement>('[data-submit]')!,status=form.querySelector<HTMLElement>('.form-status')!,draft=form.querySelector<HTMLElement>('.mail-draft')!;
  const submitLabel=submit.querySelector<HTMLElement>('[data-submit-label]')!;
  let mode='draft',copyText='';
  submit.disabled=false;
  fetch('/api/contact').then(r=>r.ok?r.json():null).then(result=>{if(result?.mode==='send'){mode='send';submitLabel.textContent='Enviar consulta';form.querySelector('.form-delivery-note')!.textContent='Enviaremos tu consulta directamente al equipo de Starwin.';}}).catch(()=>{});
  const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
  function showErrors(errors:Record<string,string>){for(const el of form.querySelectorAll<HTMLElement>('[data-error]')){const name=el.dataset.error!;el.textContent=errors[name]||'';field(name)?.setAttribute('aria-invalid',String(!!errors[name]));}}
  form.addEventListener('submit',async event=>{
   event.preventDefault();status.hidden=true;draft.hidden=true;
   const raw=Object.fromEntries(new FormData(form));const data={...raw,consent:field('consent').checked};
   const errors:Record<string,string>={};
   if(String(raw.name||'').trim().length<2)errors.name='Escribe tu nombre.';
   if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(raw.email||'').trim()))errors.email='Escribe un correo válido.';
   if(String(raw.message||'').trim().length<15)errors.message='Cuéntanos un poco más (al menos 15 caracteres).';
   if(!data.consent)errors.consent='Autoriza el uso de tus datos para responderte.';
   showErrors(errors);
   if(Object.keys(errors).length){field(Object.keys(errors)[0])?.focus();return;}
   submit.disabled=true;submit.setAttribute('aria-busy','true');submitLabel.textContent=mode==='send'?'Enviando…':'Preparando…';
   try{
    let response;try{response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),signal:AbortSignal.timeout(20000)});}catch{throw Error('No se pudo conectar. Tus datos siguen aquí; intenta otra vez o usa WhatsApp.');}
    const result=await response.json();
    if(!response.ok){showErrors(result.errors||{});throw Error(result.message||'No pudimos preparar la consulta.');}
    if(result.mode==='sent'){status.textContent=result.message;status.dataset.sent='true';status.hidden=false;status.focus();form.reset();}
    else {copyText=`${result.email.subject}\n\n${result.email.body}`;form.querySelector<HTMLAnchorElement>('[data-open-mail]')!.href=result.email.mailto;form.querySelector('[data-mail-preview]')!.textContent=copyText;draft.hidden=false;draft.setAttribute('tabindex','-1');draft.focus();}
   }catch(error){status.textContent=error instanceof Error?error.message:'No se pudo completar la consulta.';status.dataset.sent='false';status.hidden=false;status.focus();}
   finally{submit.disabled=false;submit.removeAttribute('aria-busy');submitLabel.textContent=mode==='send'?'Enviar consulta':'Preparar consulta';}
  });
  form.querySelector('[data-copy-mail]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(copyText);form.querySelector('[data-copy-status]')!.textContent='Consulta copiada. Pégala en un correo para starwinchile@gmail.com.';}catch{form.querySelector('[data-copy-status]')!.textContent='Puedes seleccionar y copiar el texto en «Ver el mensaje preparado».';}});
 }
</script>
