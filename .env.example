# Modo de muestras gratuito: cuenta personal gratuita de Hugging Face.
# Para usar localmente el proveedor de la web publicada, sin claves:
# VISUALIZER_REMOTE_ORIGIN=https://starwinpvc.cl
# Crea tu propio token; no uses credenciales de terceros. El cupo del proveedor es limitado.
VISUALIZER_PROVIDER=qwen-space
VISUALIZER_ALLOW_FREE_GENERATION=true
HF_TOKEN=

# Alternativa de Google, solo si seleccionas VISUALIZER_PROVIDER=google.
# Copiar a .env en la raíz del proyecto; nunca subir .env ni pegar claves en el chat.
# El visualizador permanece deshabilitado si falta cualquiera de estas variables.
# Confirmar que la clave fue emitida por Google Gemini antes de elegir este proveedor.
GEMINI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Google no ofrece cuota gratuita de imágenes por API. False bloquea toda generación.
# Solo cambiar después de autorizar un presupuesto de pago.
GEMINI_ALLOW_PAID_GENERATION=false
# Pausa operativa después de un HTTP 402; quitar solo al corregir el saldo del proyecto.
VISUALIZER_BILLING_HOLD=false
VISUALIZER_SESSION_LIMIT=3
VISUALIZER_GLOBAL_DAILY_LIMIT=30
VISUALIZER_CONCURRENCY=2

# Envío real de contacto. Sin ambos valores se prepara un correo, no se envía.
RESEND_API_KEY=
CONTACT_FROM=

# Solo para el proceso local. No altera la publicación ni crea infraestructura.
PORT=3006

